"""
A Dagger module for working with Docker and Docker Compose projects.

https://dagger.io
https://docs.docker.com/reference/dockerfile/
"""
type Docker {
  """
  Image used for Dockerfile linting.
  """
  pub lintImage: String! = "docker.io/hadolint/hadolint:v2.14.0-alpine"

  """
  The Docker projects visible from the client's cwd: every directory at or
  below it holding a Dockerfile, plus the nearest enclosing project when the
  cwd holds no Dockerfile of its own. Paths are cwd-relative, so a ".." prefix
  marks an enclosing project.
  """
  pub projects(ws: Workspace!): [DockerProject!]! {
    polyfill
      .workspace(ws)
      .findConfigDirs(["Dockerfile"])
      .map { projectPath =>
        DockerProject(path: projectPath, lintImage: lintImage)
      }
  }

  """
  Return the Docker project containing a path, relative to the client's cwd.

  By default, path may be a project root or a directory inside a project. Set
  findUp to false when path is already a project root and no lookup is needed.
  """
  pub project(ws: Workspace!, path: String!, findUp: Boolean! = true): DockerProject! {
    DockerProject(
      path: if (findUp) {
        let foundDockerfilePath = ws.findUp("Dockerfile", path)
        if (foundDockerfilePath == null) {
          raise "no Docker project found containing path: " + path
        } else {
          relativeToCwd(ws, foundDockerfilePath)
        }
      } else {
        path
      },
      lintImage: lintImage,
    )
  }

  """
  Return the directory of a workspace-root-absolute file path, relative to the
  client's cwd: "/a/b/Dockerfile" from cwd "a" is "b", from "a/b/c" is "..".
  """
  let relativeToCwd(ws: Workspace!, filePath: String!): String! {
    let dirSegments = filePath.trimPrefix("/").split("/").dropLast(1)
    let cwdSegments = ws.path.trimPrefix("/").split("/").filter { segment =>
      segment != "" and segment != "."
    }
    # Longest common prefix: acc only advances while every prior segment matched.
    let common = cwdSegments.map { segment, i => i }.reduce(0) { acc, i =>
      if (acc == i and dirSegments[i] == cwdSegments[i]) { acc + 1 } else { acc }
    }
    let segments = cwdSegments.dropFirst(common).map { segment => ".." } +
      dirSegments.dropFirst(common)
    if (segments.length == 0) { "." } else { segments.join("/") }
  }

  """
  Lint the Dockerfile of every project visible from the client's cwd. A cwd
  holding no Dockerfile of its own sits inside its enclosing project, so that
  project is linted too; enter a subproject to lint it alone.
  """
  pub lintAll(ws: Workspace!): Void @check {
    let layers = projects(ws).map { project, i =>
      directory.withFile(toString(i) + "/Dockerfile", project.lintExec(ws).file("Dockerfile"))
    }.reduce(directory) { merged, layer => merged.withDirectory(".", layer) }
    # FIXME: replace this when Dagger can directly run multiple containers in
    # parallel. For now, merge one file from each project's lint container into
    # a directory (keyed by project position, since a cwd-relative ".." path
    # is not a valid directory name) and sync it to force every lint command
    # to run.

    layers.sync
    null
  }

  """
  Build every project visible from the client's cwd.
  """
  pub buildAll(ws: Workspace!): Void @check {
    let layers = projects(ws).map { project, i =>
      directory.withDirectory(toString(i), project.build(ws).rootfs)
    }.reduce(directory) { merged, layer => merged.withDirectory(".", layer) }
    # FIXME: replace this when Dagger can directly run multiple containers in
    # parallel. For now, merge each built container's rootfs into a directory
    # (keyed by project position, since a cwd-relative ".." path is not a
    # valid directory name) and sync it to force every build to run.

    layers.sync
    null
  }

  """
  Build every named Dockerfile stage that no other stage references.

  A default build only exercises the final stage and its dependency chain;
  this check covers the stages a default build never reaches, such as test
  or lint stages.
  """
  pub buildUnrefStages(ws: Workspace!): Void @check {
    let layers = projects(ws).map { project, i =>
      project
        .stages(ws)
        .filter { stage => stage.name != null and stage.referenced == false }
        .reduce(directory) { stageLayers, stage =>
          stageLayers.withDirectory(
            toString(i) + "/" + (stage.name ?? ""),
            stage.build(ws).rootfs,
          )
        }
    }.reduce(directory) { merged, layer => merged.withDirectory(".", layer) }
    # FIXME: replace this when Dagger can directly run multiple containers in
    # parallel. For now, merge each built stage's rootfs into a directory
    # (keyed by project position, since a cwd-relative ".." path is not a
    # valid directory name) and sync it to force every stage build to run.

    layers.sync
    null
  }


  """
  Spawn an ephemeral Docker Engine in a container.
  """
  pub engine(
    """
    Docker Engine version.
    """
    version: String! = "24.0",
    """
    Persist the state of the engine in a cache volume.
    """
    persist: Boolean! = true,
    """
    Namespace for persisting the engine state. Use in combination with persist.
    """
    namespace: String! = "",
  ): Service! {
    let base = container
      .from("index.docker.io/docker:" + version + "-dind")
      .withoutEntrypoint
      .withExposedPort(2375)
    let engineContainer = if (persist) {
      let volumeName = "docker-engine-state-" + version + (
        if (namespace == "") { "" } else { "-" + namespace }
      )
      base.withMountedCache("/var/lib/docker", cacheVolume(volumeName), sharing: LOCKED)
    } else {
      base
    }
    engineContainer.asService(
      args: [
        "dockerd",
        "--host=tcp://0.0.0.0:2375",
        "--host=unix:///var/run/docker.sock",
        "--tls=false",
      ],
      insecureRootCapabilities: true,
    )
  }

  """
  Tools for validating Docker Compose projects.
  """
  pub compose: Compose! {
    Compose()
  }

  """
  A Docker CLI ready to query this engine.
  """
  pub cli(
    """
    Version of the Docker CLI to run.
    """
    version: String! = "24.0",
    """
    Specify the Docker Engine to connect to. By default, run an ephemeral engine.
    """
    engine: Service = null,
  ): CLI! {
    CLI(engine: engine ?? self.engine(version: version))
  }

}

"""
A Docker client.
"""
type CLI {
  """
  The Docker Engine this client is wired to.
  """
  pub engine: Service!

  """
  Package the Docker CLI into a container, wired to an engine.
  """
  pub container: Container! {
    Dagger.container
      .from("index.docker.io/docker:cli")
      .withoutEntrypoint
      .withServiceBinding("dockerd", engine)
      .withEnvVariable("DOCKER_HOST", "tcp://dockerd:2375")
  }

  """
  Execute 'docker pull'.
  """
  pub pull(
    """
    The docker repository to pull from. Example: registry.dagger.io/engine
    """
    repository: String!,
    """
    The docker image tag to pull.
    """
    tag: String! = "latest",
  ): Image! {
    load(Dagger.container.from(repository + ":" + tag))
  }

  """
  Execute 'docker push'.
  """
  pub push(
    """
    The docker repository to push to.
    """
    repository: String!,
    """
    The tag to push to.
    """
    tag: String! = "latest",
  ): String! {
    image(repository: repository, tag: tag).push
  }

  """
  Execute 'docker pull' and return the CLI state, for chaining.
  """
  pub withPull(repository: String!, tag: String! = "latest"): CLI! {
    pull(repository, tag)
    self
  }

  """
  Execute 'docker push' and return the CLI state, for chaining.
  """
  pub withPush(repository: String!, tag: String! = "latest"): CLI! {
    push(repository, tag)
    self
  }

  """
  Load a container into the Docker Engine cache (docker load).
  """
  pub load(
    """
    The container to load.
    """
    ctr: Container!,
  ): Image! {
    let out = self.container
      .withMountedFile("/import.tar", ctr.asTarball)
      .withExec(["docker", "load", "-q", "-i", "/import.tar"])
      .stdout
    let m = out.match("Loaded image ID: (sha256:[a-fA-F0-9]{64})")
    if (m == null) {
      raise "docker load failed or went undetected"
    } else {
      let id = m.captures[0]
      if (id == null) {
        raise "docker load failed or went undetected"
      } else {
        Image(client: self, localID: id)
      }
    }
  }

  """
  Look up an image in the local Docker Engine cache.
  If exactly one image matches the filters, return it. Otherwise, raise an error.
  """
  pub image(
    """
    Filter by image repository.
    """
    repository: String! = "",
    """
    Filter by image tag.
    """
    tag: String! = "latest",
    """
    Filter by image local ID (short IDs are allowed).
    """
    localID: String! = "",
  ): Image! {
    let matches = images(repository: repository, tag: tag, localID: localID)
    let criteria = "repository=" + repository + " tag=" + tag + " id=" + localID
    if (matches.length > 1) {
      raise "more than one image matches the search criteria: " + criteria
    }
    let found = matches[0]
    if (found == null) {
      raise "no image matches the search criteria: " + criteria
    } else {
      found
    }
  }

  """
  List images in the local Docker Engine cache.
  """
  pub images(
    """
    Filter by image repository.
    """
    repository: String! = "",
    """
    Filter by image tag.
    """
    tag: String! = "",
    """
    Filter by image local ID.
    """
    localID: String! = "",
  ): [Image!]! {
    self.container
      .withExec(["docker", "image", "list", "-a", "--no-trunc", "--format", "{{json .}}"])
      .stdout
      .split("\n")
      .filter { line => line != "" }
      .map { line =>
        fromJSON(line) :: {{ID: String!, Repository: String!, Tag: String!}}!
      }
      .filter { info =>
        (repository == "" or repository == info.Repository) and
        (tag == "" or tag == info.Tag) and
        (localID == "" or info.ID.hasPrefix(localID))
      }
      .map { info =>
        Image(client: self, localID: info.ID, repository: info.Repository, tag: info.Tag)
      }
  }

  """
  Run a container with the docker CLI.
  """
  pub run(
    """
    Name of the image to run. Example: registry.dagger.io/engine
    """
    name: String!,
    """
    Tag of the image to run.
    """
    tag: String! = "latest",
    """
    Additional arguments.
    """
    args: [String!]! = [],
  ): String! {
    self.container.withExec(["docker", "run", name + ":" + tag] + args).stdout
  }

}

"""
An image stored in the local Docker Engine cache.
"""
type Image {
  let client: CLI!

  """
  The local identifier of the docker image.
  """
  pub localID: String!

  """
  The image repository.
  """
  pub repository: String! = ""

  """
  The image tag.
  """
  pub tag: String! = ""

  """
  Export this image from the docker engine into Dagger.
  """
  pub export: Container! {
    let archive = client.container
      .withExec(["docker", "image", "save", "-o", "/export.tar", localID])
      .file("/export.tar")
    Dagger.container.import(archive)
  }


  """
  Push this image to a registry.
  """
  pub push: String! {
    export.publish(ref)
  }

  """
  Return the image's ref (remote address).
  """
  pub ref: String! {
    let refTag = if (tag == "") { "latest" } else { tag }
    let address = repository + ":" + refTag
    if (localID == "") { address } else { address + "@" + localID }
  }

}

"""
A Docker project rooted at a directory containing a Dockerfile.
"""
type DockerProject {
  """
  Path of this project root, relative to the client's cwd. A ".." prefix
  marks an enclosing project.
  """
  pub path: String!

  """
  Image used for Dockerfile linting.
  """
  let lintImage: String!

  """
  Return a cwd-relative path for a project-relative subpath.
  """
  let subpath(relativePath: String!): String! {
    if (path == ".") {
      relativePath
    } else {
      path.trimSuffix("/") + "/" + relativePath
    }
  }

  """
  Cwd-relative path of this project's Dockerfile.
  """
  pub dockerfilePath: String! {
    subpath("Dockerfile")
  }

  """
  Build context mounted for this project's Docker commands.
  """
  pub buildContext(ws: Workspace!): Directory! {
    ws.directory(path)
  }

  """
  Build the container from this project's Dockerfile.
  """
  pub build(
    ws: Workspace!,
    """
    Target build stage to build.
    """
    target: String! = "",
    """
    Platform to build for, e.g. "linux/amd64". Defaults to the host platform.
    """
    platform: String = null,
  ): Container! {
    if (platform == null) {
      buildContext(ws).dockerBuild(target: target)
    } else {
      buildContext(ws).dockerBuild(target: target, platform: platform :: Platform!)
    }
  }

  """
  Build stages declared in this project's Dockerfile, in declaration order.

  Stages are parsed from FROM instructions as described in the Dockerfile
  reference (https://docs.docker.com/reference/dockerfile/). Parsing is
  line-based: a FROM inside a heredoc or after a line continuation is not
  distinguished from a real instruction.
  """
  pub stages(ws: Workspace!): [DockerfileStage!]! {
    let contents = ws.file(dockerfilePath).contents
    let fromMatches = contents.matchAll("(?im)^\\s*FROM\\s+(?:--\\S+\\s+)*(\\S+)(?:\\s+AS\\s+(\\S+))?")
    # Stage references, lowercased since stage names are case-insensitive:
    # FROM bases, COPY/ADD --from=<ref>, and RUN --mount=...,from=<ref>.
    let references = fromMatches.map { m => (m.captures[0] ?? "").toLower } +
      contents.matchAll("(?i)--from=(\\S+)").map { m => (m.captures[0] ?? "").toLower } +
      contents.matchAll("(?i)[=,]from=([^,\\s]+)").map { m => (m.captures[0] ?? "").toLower }
    fromMatches.map { m, i =>
      let stageName = m.captures[1]
      let name = if (stageName == "" or stageName == null) { null } else { stageName }
      DockerfileStage(
        project: self,
        index: i,
        base: m.captures[0] ?? "",
        name: name,
        referenced: references.contains((name ?? "").toLower) or
          references.contains(toString(i)),
      )
    }
  }

  """
  Return the named build stage of this project's Dockerfile.
  """
  pub stage(ws: Workspace!, name: String!): DockerfileStage! {
    let found = stages(ws).filter { candidate => candidate.name == name }[0]
    if (found == null) {
      raise "no stage named \"" + name + "\" in " + dockerfilePath
    } else {
      found
    }
  }

  """
  Lint this project's Dockerfile.
  """
  pub lint(ws: Workspace!): Void @check {
    lintExec(ws).sync
    null
  }

  """
  Container synced by this project's lint check.
  """
  let lintExec(ws: Workspace!): Container! {
    container
      .from(lintImage)
      .withWorkdir("/src")
      .withDirectory(".", ws.directory(path, include: ["Dockerfile"]))
      .withExec(["hadolint", "Dockerfile"])
  }

}

"""
A build stage of a Docker project's Dockerfile.
"""
type DockerfileStage {
  """
  The Docker project whose Dockerfile declares this stage.
  """
  pub project: DockerProject!

  """
  Zero-based position of this stage in the Dockerfile.
  """
  pub index: Int!

  """
  Image or prior stage this stage builds from.
  """
  pub base: String!

  """
  Stage name declared with AS. Null for unnamed stages.
  """
  pub name: String

  """
  Whether another stage in the Dockerfile references this stage, as a FROM
  base, a COPY/ADD --from source, or a RUN --mount from source. References by
  name (case-insensitive) and by stage index are both counted.
  """
  pub referenced: Boolean!

  """
  Build this stage of the project's Dockerfile.
  """
  pub build(
    ws: Workspace!,
    """
    Platform to build for, e.g. "linux/amd64". Defaults to the host platform.
    """
    platform: String = null,
  ): Container! {
    let target = name
    if (target == null) {
      raise "cannot build stage " + toString(index) + " of " + project.dockerfilePath +
        " by target: it has no name"
    } else {
      project.build(ws, target: target, platform: platform)
    }
  }

}
