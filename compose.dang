"""
Tools for validating Docker Compose projects.

https://docs.docker.com/reference/compose-file/
"""
type Compose {
  """
  Image providing the standalone Compose binary at /docker-compose.
  """
  pub composeImage: String! = "index.docker.io/docker/compose-bin"

  """
  Filenames that mark a Compose project, in the order Compose itself prefers
  them.
  """
  let configNames: [String!]! = [
    "compose.yaml",
    "compose.yml",
    "docker-compose.yaml",
    "docker-compose.yml",
  ]

  """
  The Compose projects visible from the client's cwd: every directory at or
  below it holding a Compose file, plus the nearest enclosing project when the
  cwd holds no Compose file of its own. Paths are cwd-relative, so a ".."
  prefix marks an enclosing project.
  """
  pub projects(ws: Workspace!): [ComposeProject!]! {
    polyfill
      .workspace(ws)
      .findConfigDirs(configNames)
      .map { projectPath =>
        ComposeProject(path: projectPath, composeImage: composeImage, configNames: configNames)
      }
  }


  """
  Return the number of path segments of a workspace-root-absolute file path.
  """
  let depth(filePath: String!): Int! {
    filePath.trimPrefix("/").split("/").length
  }

  """
  Return the directory of a workspace-root-absolute file path, relative to the
  client's cwd: "/a/b/compose.yaml" from cwd "a" is "b", from "a/b/c" is "..".
  """
  let relativeToCwd(ws: Workspace!, filePath: String!): String! {
    let dirSegments = filePath.trimPrefix("/").split("/").dropLast(1)
    let cwdSegments = ws.path.trimPrefix("/").split("/").filter { segment =>
      segment != "" and segment != "."
    }
    # Longest common prefix: acc only advances while every prior segment matched.
    let common = cwdSegments.map { segment, i => i }.reduce(0) { acc, i =>
      if (acc == i and dirSegments[i] == cwdSegments[i]) { acc + 1 } else { acc }
    }
    let segments = cwdSegments.dropFirst(common).map { segment => ".." } +
      dirSegments.dropFirst(common)
    if (segments.length == 0) { "." } else { segments.join("/") }
  }

  """
  Run the services of the Compose project detected from the client's cwd,
  proxied through a single service with one frontend port per compose service.

  Exactly one project must be visible: enter a project directory to choose it.
  Each service that declares an image and a port is started from its image
  and proxied on its published port (or its target port when none is
  published). Services without an image (such as build-only services) are
  skipped for now.
  """
  pub startServices(ws: Workspace!): Service! @up {
    let detected = projects(ws)
    if (detected.length > 1) {
      raise "multiple Compose projects detected (" +
        detected.map { project => project.path }.join(", ") +
        "); enter a project directory to choose one"
    }
    let single = detected[0]
    if (single == null) {
      raise "no Compose project detected"
    } else {
      single
        .serviceSpecs(ws)
        .filter { spec => spec.image != "" and spec.target != 0 }
        .reduce(proxy) { front, spec =>
          front.withService(
            service: container
              .from(spec.image)
              .withExposedPort(spec.target)
              .asService(useEntrypoint: true),
            name: spec.name,
            frontend: if (spec.published == 0) { spec.target } else { spec.published },
            backend: spec.target,
          )
        }
        .service
    }
  }

  """
  Validate the Compose file of every project visible from the client's cwd. A
  cwd holding no Compose file of its own sits inside its enclosing project, so
  that project is validated too; enter a subproject to validate it alone.
  """
  pub lint(ws: Workspace!): Void @check {
    let layers = projects(ws).map { project, i =>
      directory.withFile(
        toString(i) + "/" + project.configName(ws),
        project.lintExec(ws).file(project.configName(ws)),
      )
    }.reduce(directory) { merged, layer => merged.withDirectory(".", layer) }
    # FIXME: replace this when Dagger can directly run multiple containers in
    # parallel. For now, merge one file from each project's lint container into
    # a directory (keyed by project position, since a cwd-relative ".." path
    # is not a valid directory name) and sync it to force every lint command
    # to run.

    layers.sync
    null
  }

}

"""
A Compose project rooted at a directory containing a Compose file.
"""
type ComposeProject {
  """
  Path of this project root, relative to the client's cwd. A ".." prefix
  marks an enclosing project.
  """
  pub path: String!

  """
  Image providing the standalone Compose binary at /docker-compose.
  """
  let composeImage: String!

  """
  Filenames that mark a Compose project, in the order Compose itself prefers
  them.
  """
  let configNames: [String!]!

  """
  Filename of this project's Compose file, following Compose's own preference
  order when several are present.
  """
  let configName(ws: Workspace!): String! {
    let present = ws.directory(path, include: configNames).glob("*")
    let found = configNames.filter { name => present.contains(name) }[0]
    if (found == null) {
      raise "no Compose file in " + path
    } else {
      found
    }
  }

  """
  Cwd-relative path of this project's Compose file.
  """
  pub configPath(ws: Workspace!): String! {
    if (path == ".") {
      configName(ws)
    } else {
      path.trimSuffix("/") + "/" + configName(ws)
    }
  }

  """
  Name of every service declared by this project's Compose file.
  """
  pub services(ws: Workspace!): [String!]! {
    base(ws)
      .withExec(["/docker-compose", "-f", configName(ws), "config", "--services"])
      .stdout
      .split("\n")
      .filter { line => line != "" }
  }

  """
  Name, image, and first port mapping of every service declared by this
  project's Compose file. Ports are 0 when the service declares none.
  """
  let serviceSpecs(ws: Workspace!): [{{name: String!, image: String!, target: Int!, published: Int!}}!]! {
    # The compose JSON keys services by name, which type-driven fromJSON can't
    # parse; jq flattens it to a fixed-shape list first.
    let specs = container
      .from("docker.io/library/alpine:3.20")
      .withExec(["apk", "add", "--no-cache", "jq"])
      .withFile("/usr/local/bin/docker-compose", container.from(composeImage).file("/docker-compose"))
      .withWorkdir("/src")
      .withDirectory(".", ws.directory(path))
      .withExec([
        "sh",
        "-c",
        "docker-compose -f " + configName(ws) + " config --format json | " +
          "jq -c '[.services | to_entries[] | {name: .key, " +
          "image: (.value.image // \"\"), " +
          "target: (.value.ports[0].target // 0), " +
          "published: ((.value.ports[0].published // \"0\") | tonumber)}]'",
      ])
      .stdout
    fromJSON(specs)
  }

  """
  Validate this project's Compose file with 'docker compose config'.
  """
  pub lint(ws: Workspace!): Void @check {
    lintExec(ws).sync
    null
  }

  """
  Container synced by this project's lint check.
  """
  let lintExec(ws: Workspace!): Container! {
    base(ws).withExec(["/docker-compose", "-f", configName(ws), "config", "--quiet"])
  }

  """
  Compose container with this project mounted. The whole project directory is
  mounted, since Compose files can reference sibling files such as env_file
  entries.
  """
  let base(ws: Workspace!): Container! {
    container
      .from(composeImage)
      .withWorkdir("/src")
      .withDirectory(".", ws.directory(path))
  }

}
