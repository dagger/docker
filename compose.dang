"""
Tools for validating and running Docker Compose projects.

https://docs.docker.com/reference/compose-file/
"""
type Compose {
  let tool: Docker!

  """
  File names that mark a Compose project, in the order Compose prefers them.
  """
  let configNames: [String!]! = [
    "compose.yaml",
    "compose.yml",
    "docker-compose.yml",
    "docker-compose.yaml",
  ]

  """
  Override file names Compose merges over a project's Compose file, in the
  order it prefers them.
  """
  let overrideNames: [String!]! = [
    "compose.override.yml",
    "compose.override.yaml",
    "docker-compose.override.yml",
    "docker-compose.override.yaml",
  ]

  """
  Compose projects at or below the working directory, keyed by the directory
  holding their Compose file.
  """
  projects(ws: Workspace!): DockerComposeProjects! {
    DockerComposeProjects(paths: tool.roots(ws, configNames), compose: self)
  }

  """
  The Compose project rooted at a workspace-root-relative path.
  """
  let projectAt(path: String!): DockerComposeProject! {
    DockerComposeProject(path: path, compose: self)
  }

  """
  The only Compose project visible from the client's cwd.
  """
  let single(ws: Workspace!): DockerComposeProject! {
    let detected = tool.roots(ws, configNames)
    if (detected.length > 1) {
      raise "multiple Compose projects detected (" + detected.join(", ")
        + "); enter a project directory to choose one"
    }
    let only = detected[0]
    if (only == null) {
      raise "no Compose project detected"
    } else {
      projectAt(only ?? "")
    }
  }
}

"""
Compose projects in a workspace, keyed by the directory holding their Compose
file.
"""
type DockerComposeProjects @collection {
  """
  Project root paths, relative to the workspace root.
  """
  paths: [String!]! @keys

  let compose: Compose!

  """
  The Compose project rooted at path.
  """
  project(path: String!): DockerComposeProject! @get {
    compose.projectAt(path)
  }

  """
  Validate the Compose files of the selected projects.
  """
  lint(ws: Workspace!): Void @check {
    # A selection over a list evaluates its elements concurrently, so every
    # project is validated in parallel and every failure is reported.
    let failures = paths.map { p => project(p) }.{{path, failure: lintFailure(ws)}}
      .filter { r => r.failure != null }
      .map { r => r.path + ": " + (r.failure ?? "") }
    let failed = compose.tool.report(
      "docker compose config failed",
      paths.length,
      "projects",
      failures,
    )
    if (failed != null) {
      raise failed ?? ""
    }
    null
  }
}

"""
A Compose project rooted at a directory containing a Compose file.
"""
type DockerComposeProject {
  """
  Project root, relative to the workspace root.
  """
  path: String!

  let compose: Compose!

  """
  The first of names present in this project's directory, or null.
  """
  let firstPresent(ws: Workspace!, names: [String!]!): String {
    let present = ws.directory(compose.tool.absolutePath(path), include: names).glob("*")
    names.filter { name => present.contains(name) }[0]
  }

  """
  Workspace-root-relative path of this project's Compose file: the first of
  compose.yaml, compose.yml, docker-compose.yml and docker-compose.yaml, as
  Compose picks it.
  """
  configPath(ws: Workspace!): String! {
    let found = firstPresent(ws, compose.configNames)
    if (found == null) {
      raise "no Compose file in " + path
    } else {
      subpath(found ?? "")
    }
  }

  """
  Workspace-root-relative path of the override file Compose merges over the
  Compose file (compose.override.yml and its variants), or null.
  """
  overridePath(ws: Workspace!): String {
    let found = firstPresent(ws, compose.overrideNames)
    if (found == null) { null } else { subpath(found ?? "") }
  }

  """
  Services declared by this project's Compose file and its override file,
  keyed by service name.

  Names are read from the files' top-level services mappings without running
  Compose; a file that cannot be read this way lists no services.
  """
  services(ws: Workspace!): DockerComposeServices! {
    let empty: [String!]! = []
    let names = {
      let override = overridePath(ws)
      let files = [configPath(ws)] + (if (override == null) { empty } else { [override ?? ""] })
      files.reduce(empty) { acc, file =>
        acc + parseServiceNames(ws.file(compose.tool.absolutePath(file)).contents)
      }
    } rescue {
      err: Error => empty
    }
    DockerComposeServices(names: compose.tool.sorted(names.uniq), project: self)
  }

  """
  Validate this project's Compose file with 'docker compose config'.
  """
  lint(ws: Workspace!): Void @check {
    let failure = lintFailure(ws)
    if (failure != null) {
      raise path + ": " + (failure ?? "")
    }
    null
  }

  """
  Why 'docker compose config' rejected this project's Compose file, or null.
  """
  let lintFailure(ws: Workspace!): String {
    let ran = Dagger
      .container
      .from(compose.tool.composeImage)
      .withDirectory(mountPath, projectDir(ws))
      .withWorkdir(mountPath)
      .withExec(["/docker-compose", "config", "--quiet"], expect: ReturnType.ANY)
    let code = ran.exitCode
    if (code == 0) {
      null
    } else {
      let output = (ran.stderr + "\n" + ran.stdout).trimSpace.split("\n").takeLast(20).join("\n")
      "docker compose config failed (exit " + toString(code) + ")"
        + (if (output == "") { "" } else { ":\n" + output })
    }
  }

  """
  The service names declared under the top-level services key of Compose
  file text, read line by line. Handles block and flow mappings, quoted keys
  and comments; text it cannot read yields no names.
  """
  let parseServiceNames(text: String!): [String!]! {
    let empty: [String!]! = []
    # A leading byte order mark would hide the first key.
    let lines = text.rewriteMatches(`^\x{FEFF}`) { m => "" }.split("\n").map { l => l.trimSuffix("\r") }
    let starts = lines
      .map { l, i => if (servicesValue(l) == null) { -1 } else { i } }
      .filter { i => i >= 0 }
    if (starts.length == 0) {
      empty
    } else {
      let start = starts[0] ?? 0
      # The services mapping runs until the next line that starts at column
      # 0 with anything but a comment.
      let body = lines.dropFirst(start + 1).takeWhile { l =>
        l.trimSpace == "" or l.hasPrefix(" ") or l.hasPrefix("#")
      }
      let value = stripComment(servicesValue(lines[start] ?? "") ?? "")
        .trimSpace
        .rewriteMatches(`^&\S+\s*`) { m => "" }
      let content = body.filter { l =>
        l.trimSpace != "" and l.trimSpace.hasPrefix("#") == false
      }
      if (value.hasPrefix("{")) {
        flowKeys(([value] + content.map { l => stripComment(l) }).join(" "))
      } else if (value != "") {
        # An alias or a scalar: nothing to read.
        empty
      } else {
        let first = content[0] ?? ""
        if (first.trimSpace.hasPrefix("{")) {
          flowKeys(content.map { l => stripComment(l) }.join(" "))
        } else {
          let indent = indentOf(first)
          content
            .filter { l => indentOf(l) == indent }
            .map { l => keyOf(l.trimSpace) }
            .filter { k => k != "" }
        }
      }
    }
  }

  """
  The text after "services:" when line is the top-level services key, else
  null.
  """
  let servicesValue(line: String!): String {
    line.matchAll(`^(?:services|"services"|'services')\s*:(?:\s(.*))?$`).map { m =>
      m.captures[0] ?? ""
    }[0]
  }

  """
  line without a trailing comment.
  """
  let stripComment(line: String!): String! {
    line.rewriteMatches(`(?:^|\s)#.*$`) { m => "" }
  }

  """
  The number of spaces line is indented by.
  """
  let indentOf(line: String!): Int! {
    line.split("").takeWhile { c => c == " " }.length
  }

  """
  The key of a block mapping entry, or "" when entry is not one: plain,
  'single-quoted' and "double-quoted" keys are read; sequence items, merge
  keys and complex keys are not.
  """
  let keyOf(entry: String!): String! {
    if (entry.hasPrefix("\"")) {
      entry.matchAll(`^"((?:[^"\\]|\\.)*)"\s*:(?:\s|$)`).map { m => m.captures[0] ?? "" }[0] ?? ""
    } else if (entry.hasPrefix("'")) {
      (entry.matchAll(`^'((?:[^']|'')*)'\s*:(?:\s|$)`).map { m => m.captures[0] ?? "" }[0] ?? "")
        .replace("''", "'")
    } else if (entry == "-" or entry.hasPrefix("- ") or entry.hasPrefix("? ") or entry.hasPrefix("<<")) {
      ""
    } else {
      entry.matchAll(`^([^\s#'"\[\]{},&*!|>%@][^#]*?)\s*:(?:\s|$)`).map { m => m.captures[0] ?? "" }[0]
        ?? ""
    }
  }

  """
  The top-level keys of a flow mapping such as {web: {image: nginx}, db: {}}.
  """
  let flowKeys(text: String!): [String!]! {
    let inner = text.trimSpace.trimPrefix("{").split("}").dropLast(1).join("}")
    # Drop nested mappings and sequences, innermost first, so only the
    # top-level entries remain.
    let flat = [1, 2, 3, 4, 5, 6, 7, 8].reduce(inner) { acc, pass =>
      acc.rewriteMatches(`\{[^{}]*\}|\[[^\[\]]*\]`) { m => "" }
    }
    flat.split(",").map { e => keyOf(e.trimSpace) }.filter { k => k != "" }
  }

  """
  Where this project is mounted for Compose: under /ws, at its place in the
  workspace, so Compose resolves paths outside it to paths under /ws too.
  """
  let mountPath: String! {
    if (path == ".") { "/ws" } else { "/ws/" + path }
  }

  """
  jq filter flattening 'docker compose config --format json' into the
  shape of ComposeServiceSpec, with paths made workspace-relative and the
  features up and injectServices can't reproduce listed as warnings.
  """
  let specFilter: String! {
    ```
    def wspath: if . == "/ws" then "." elif startswith("/ws/") then .[4:] else null end;
    def kv: to_entries | map({name: .key, value: ((.value // "") | tostring)});
    def inside: ((. // "") | wspath) != null;
    . as $root
    | [(.services // {}) | to_entries[] | .key as $name | .value as $s | {
        name: $name,
        image: ($s.image // ""),
        entrypoint: ($s.entrypoint // []),
        command: ($s.command // []),
        buildContext: ($s.build.context // ""),
        buildDockerfile: ($s.build.dockerfile // ""),
        buildTarget: ($s.build.target // ""),
        buildArgs: (($s.build.args // {}) | kv),
        environment: (($s.environment // {}) | kv),
        ports: [($s.ports // [])[] | select((.protocol // "tcp") == "tcp")
          | {target, published: ((.published // "") | tostring | if . == "" then 0 else tonumber end)}],
        expose: [($s.expose // [])[] | tostring | select(test("^[0-9]+(/tcp)?$")) | sub("/tcp$"; "") | tonumber],
        dependsOn: (($s.depends_on // {}) | keys),
        user: (($s.user // "") | tostring),
        workingDir: ($s.working_dir // ""),
        privileged: ($s.privileged // false),
        mounts: [($s.volumes // [])[]
          | select((.type == "bind" and (.source | inside)) or (.type == "volume" and (.source // "") != "") or .type == "tmpfs")
          | {kind: .type, source: (if .type == "bind" then (.source | wspath) else (.source // "") end), target}],
        files: ([($s.secrets // [])[] | select($root.secrets[.source].file | inside)
            | {source: ($root.secrets[.source].file | wspath),
               target: (if (.target // "") == "" then "/run/secrets/" + .source elif (.target | startswith("/")) then .target else "/run/secrets/" + .target end)}]
          + [($s.configs // [])[] | select($root.configs[.source].file | inside)
            | {source: ($root.configs[.source].file | wspath),
               target: (if (.target // "") == "" then "/" + .source elif (.target | startswith("/")) then .target else "/" + .target end)}]),
        warnings: ([($s.ports // [])[] | select((.protocol // "tcp") != "tcp")
            | "port \(.published // "")->\(.target)/\(.protocol) is not published: only TCP ports are"]
          + [($s.expose // [])[] | tostring | select(test("^[0-9]+(/tcp)?$") | not)
            | "expose \(.) is ignored: only single TCP ports are"]
          + [($s.volumes // [])[] | select(.type == "bind" and (.source | inside | not))
            | "bind mount \(.source) is not mounted: it is outside the workspace"]
          + [($s.volumes // [])[] | select(.type != "bind" and .type != "volume" and .type != "tmpfs")
            | "\(.type) mount at \(.target) is not mounted"]
          + [($s.secrets // [])[] | select($root.secrets[.source].file | inside | not)
            | "secret \(.source) is not mounted: only secrets from files in the workspace are"]
          + [($s.configs // [])[] | select($root.configs[.source].file | inside | not)
            | "config \(.source) is not mounted: only configs from files in the workspace are"]
          + [$s | keys[] | select(IN("cap_add", "cap_drop", "devices", "dns", "deploy", "extra_hosts", "init",
              "ipc", "network_mode", "pid", "platform", "runtime", "security_opt", "shm_size", "stop_signal",
              "sysctls", "tmpfs", "ulimits"))
            | "\(.) is ignored"])
      }]
    ```
  }

  """
  Every service of this project as resolved by 'docker compose config',
  which reads the Compose file and its override file the way 'docker compose
  up' does. Services behind a profile are included only with allProfiles.
  """
  let serviceSpecs(ws: Workspace!, allProfiles: Boolean! = false): [ComposeServiceSpec!]! {
    # The compose JSON keys services (and build args) by name, which
    # type-driven JSON.decode can't parse; jq flattens them first.
    let specs = container
      .from("docker.io/library/alpine:3.20")
      .withExec(["apk", "add", "--no-cache", "jq"])
      .withFile(
        "/usr/local/bin/docker-compose",
        container.from(compose.tool.composeImage).file("/docker-compose"),
      )
      .withNewFile("/spec.jq", specFilter)
      .withDirectory(mountPath, projectDir(ws))
      .withWorkdir(mountPath)
      .withExec([
        "sh",
        "-c",
        "docker-compose" + (if (allProfiles) { " --profile '*'" } else { "" })
          + " config --format json | jq -c -f /spec.jq",
      ])
      .stdout
    JSON.decode(specs)
  }

  """
  The specs of the named services, in the order given, whatever their
  profiles. Raises for a name 'docker compose config' does not know.
  """
  let specsNamed(ws: Workspace!, names: [String!]!): [ComposeServiceSpec!]! {
    let specs = serviceSpecs(ws, allProfiles: true)
    names.map { n =>
      let found = specs.filter { spec => spec.name == n }[0]
      if (found == null) {
        raise "service " + n + " is not in the resolved configuration of " + path
      } else {
        found
      }
    }
  }

  """
  The specs of the named services and the services they depend on, among
  the services Compose starts by default: services behind a profile, and
  names it does not know, are left out.
  """
  let activeSpecs(ws: Workspace!, names: [String!]!): [ComposeServiceSpec!]! {
    let specs = serviceSpecs(ws)
    let empty: [String!]! = []
    # Each pass adds the dependencies of what is already in, so as many
    # passes as services reach every transitive dependency.
    let wanted = specs.reduce(names) { acc, pass =>
      (acc + specs.filter { s => acc.contains(s.name) }.reduce(empty) { deps, s => deps + s.dependsOn }).uniq
    }
    specs.filter { s => wanted.contains(s.name) }
  }

  """
  Service names in start order: each service after the services it depends
  on; among the services ready to start, image-only ones first, then by
  name. A dependency cycle is broken in that order too.
  """
  let startOrder(specs: [ComposeServiceSpec!]!): [String!]! {
    let names = specs.map { s => s.name }
    let empty: [String!]! = []
    specs.reduce(empty) { done, pass =>
      let pending = specs.filter { s => done.contains(s.name) == false }
      let ready = pending.filter { s =>
        s.dependsOn.all { d => done.contains(d) or names.contains(d) == false }
      }
      let pick = (
        ready.filter { s => s.buildContext == "" }.map { s => s.name }
          + ready.map { s => s.name }
          + pending.map { s => s.name }
      )[0]
      if (pick == null) { done } else { done + [pick ?? ""] }
    }
  }

  """
  The services of specs started in start order, each with every service
  started before it bound by name, so it can reach them as Compose's default
  network would. Warnings about what can't be reproduced are printed.
  """
  let started(ws: Workspace!, specs: [ComposeServiceSpec!]!): [ComposeStartedService!]! {
    let empty: [ComposeStartedService!]! = []
    startOrder(specs).reduce(empty) { running, name =>
      specs.filter { s => s.name == name }.reduce(running) { acc, spec =>
        spec.warnings.each { w => print("warning: " + path + " (service " + spec.name + "): " + w) }
        let bound = acc.reduce(serviceContainer(ws, spec)) { c, peer =>
          c.withServiceBinding(peer.name, peer.service)
        }
        let ports = (spec.ports.map { p => p.target } + spec.expose).uniq
        let exposed = ports.reduce(bound) { c, port => c.withExposedPort(port) }
        acc + [ComposeStartedService(name: spec.name, ports: spec.ports, service: exposed
          .asService(useEntrypoint: true, insecureRootCapabilities: spec.privileged)
          .withHostname(spec.name))]
      }
    }
  }

  """
  The services of specs behind a single proxy service that publishes every
  TCP port they publish (their target port when none is published), as raw
  TCP. Services without a published port run behind it too.
  """
  let proxied(ws: Workspace!, specs: [ComposeServiceSpec!]!): Service! {
    let running = started(ws, specs)
    let front = running.reduce(proxy) { f, r =>
      r.ports.reduce(f) { g, p =>
        g.withService(
          service: r.service,
          name: r.name + "-" + toString(p.target),
          frontend: if (p.published == 0) { p.target } else { p.published },
          backend: p.target,
          isTcp: true,
        )
      }
    }
    if (running.all { r => r.ports.length == 0 }) {
      raise "nothing to publish in " + path + ": no selected service publishes a TCP port"
    }
    # Bind every service to the proxy so the ones nothing else reaches start
    # too.
    running
      .reduce(front.ctr) { c, r => c.withServiceBinding(r.name, r.service) }
      .asService(args: ["nginx", "-g", "daemon off;"])
  }

  """
  The module's composeBase, with composeEnvs set, and the services of specs
  bound to it by name.
  """
  let inject(ws: Workspace!, specs: [ComposeServiceSpec!]!): Container! {
    started(ws, specs).reduce(compose.tool.composeBaseWithEnvs) { ctr, r =>
      ctr.withServiceBinding(r.name, r.service)
    }
  }

  """
  The workspace directory of a build context resolved by 'docker compose
  config', which makes it absolute under /ws.
  """
  let buildContextDir(ws: Workspace!, context: String!): Directory! {
    if (context == "/ws") {
      ws.directory("/")
    } else if (context.hasPrefix("/ws/")) {
      ws.directory("/" + context.trimPrefix("/ws/"))
    } else {
      raise "unsupported build context " + context.replace("/ws/", "", count: 1)
        + ": only directories inside the workspace can be built"
    }
  }

  """
  The image a service with a build context builds.
  """
  let buildImage(ws: Workspace!, spec: ComposeServiceSpec!): Container! {
    let dockerfile = spec.buildDockerfile.trimPrefix(spec.buildContext + "/")
    buildContextDir(ws, spec.buildContext).dockerBuild(
      dockerfile: if (dockerfile == "") { "Dockerfile" } else { dockerfile },
      target: spec.buildTarget,
      buildArgs: spec.buildArgs.map { arg => BuildArg(name: arg.name, value: arg.value) },
    )
  }

  """
  The container a service runs: its image when it declares one, else the
  image its build context builds, with its entrypoint, command, environment,
  user, working directory, mounts, secrets and configs.
  """
  let serviceContainer(ws: Workspace!, spec: ComposeServiceSpec!): Container! {
    let image = if (spec.image != "") {
      container.from(spec.image)
    } else {
      buildImage(ws, spec)
    }
    let entry = if (spec.entrypoint.length > 0) {
      image.withEntrypoint(spec.entrypoint)
    } else {
      image
    }
    let cmd = if (spec.command.length > 0) {
      entry.withDefaultArgs(spec.command)
    } else {
      entry
    }
    let env = spec.environment.reduce(cmd) { ctr, env =>
      ctr.withEnvVariable(
        env.name,
        env.value,
      )
    }
    let user = if (spec.user != "") { env.withUser(spec.user) } else { env }
    let workdir = if (spec.workingDir != "") { user.withWorkdir(spec.workingDir) } else { user }
    let mounted = spec.mounts.reduce(workdir) { ctr, m =>
      if (m.kind == "tmpfs") {
        ctr.withMountedTemp(m.target)
      } else if (m.kind == "volume") {
        ctr.withMountedCache(m.target, cacheVolume("docker-compose:" + path + ":" + m.source))
      } else {
        let kind = entryKind(ws, m.source)
        if (kind == "directory") {
          ctr.withMountedDirectory(
            m.target,
            ws.directory(compose.tool.absolutePath(m.source)),
          )
        } else if (kind == "file") {
          ctr.withMountedFile(m.target, ws.file(
            compose.tool.absolutePath(m.source),
          ))
        } else {
          print("warning: " + path + " (service " + spec.name + "): bind mount " + m.source
            + " is not mounted: it does not exist")
          ctr
        }
      }
    }
    spec.files.reduce(mounted) { ctr, f =>
      ctr.withMountedFile(f.target, ws.file(compose.tool.absolutePath(f.source)))
    }
  }

  """
  Whether a workspace-root-relative path is a "directory", a "file", or
  "" when it does not exist.
  """
  let entryKind(ws: Workspace!, p: String!): String! {
    if (p == ".") {
      "directory"
    } else {
      let segments = p.split("/")
      let name = segments.takeLast(1).join("")
      let parent = segments.dropLast(1).join("/")
      let dir = ws.directory("/" + parent, include: [name])
      if (dir.exists(name, expectedType: ExistsType.DIRECTORY_TYPE)) {
        "directory"
      } else if (dir.exists(name)) {
        "file"
      } else {
        ""
      }
    }
  }

  """
  This project's directory.
  """
  let projectDir(ws: Workspace!): Directory! {
    ws.directory(compose.tool.absolutePath(path))
  }

  """
  Return a workspace-root-relative path for a project-relative subpath.
  """
  let subpath(relativePath: String!): String! {
    if (path == ".") { relativePath } else { path + "/" + relativePath }
  }
}

"""
Services of a Compose project, keyed by service name.
"""
type DockerComposeServices @collection {
  """
  Service names.
  """
  names: [String!]! @keys

  let project: DockerComposeProject!

  """
  The Compose service with this name.
  """
  service(name: String!): DockerComposeService! @get {
    DockerComposeService(name: name, project: project)
  }

  """
  Build the images of the selected services that declare a build.
  """
  buildService(ws: Workspace!): Void @check {
    let failures = names.map { n => service(n) }.{{name, failure: buildFailure(ws)}}
      .filter { r => r.failure != null }
      .map { r => project.path + " (service " + r.name + "): " + (r.failure ?? "") }
    let failed = project.compose.tool.report(
      "docker build failed",
      names.length,
      "services",
      failures,
    )
    if (failed != null) {
      raise failed ?? ""
    }
    null
  }

  """
  Run the selected services and the services they depend on, behind one
  proxy that publishes their TCP ports. Services behind a profile are not
  started.
  """
  up(ws: Workspace!): Service! {
    project.proxied(ws, project.activeSpecs(ws, names))
  }

  """
  The module's composeBase with the selected services and the services they
  depend on bound to it by name. Services behind a profile are not bound.
  """
  injectServices(ws: Workspace!): Container! {
    project.inject(ws, project.activeSpecs(ws, names))
  }
}

"""
A service declared by a Compose project's Compose file.
"""
type DockerComposeService {
  """
  Service name.
  """
  name: String!

  let project: DockerComposeProject!

  """
  The container this service runs: its image, or the image its build
  context builds, with its entrypoint, command, environment and mounts.
  """
  container(ws: Workspace!): Container! {
    project.serviceContainer(ws, spec(ws))
  }

  """
  What up and injectServices can't reproduce for this service, such as UDP
  ports, bind mounts outside the workspace or ignored options.
  """
  warnings(ws: Workspace!): [String!]! {
    spec(ws).warnings
  }

  """
  Build this Compose service's image, if it declares a build.
  """
  buildService(ws: Workspace!): Void @check {
    let failure = buildFailure(ws)
    if (failure != null) {
      raise project.path + " (service " + name + "): " + (failure ?? "")
    }
    null
  }

  """
  Why building this service's image failed, or null. A service without a
  build has nothing to build.
  """
  let buildFailure(ws: Workspace!): String {
    {
      let found = spec(ws)
      if (found.buildContext == "") {
        null
      } else {
        project.compose.tool.stepFailure("docker build failed", project.buildImage(
          ws,
          found,
        ))
      }
    } rescue {
      err: Error => "could not resolve the service: " + err.message
    }
  }

  """
  This service's resolved configuration.
  """
  let spec(ws: Workspace!): ComposeServiceSpec! {
    let found = project.specsNamed(ws, [name])[0]
    if (found == null) {
      raise "service " + name + " not found"
    } else {
      found
    }
  }
}

"""
A Compose service started by up or injectServices.
"""
type ComposeStartedService {
  """
  Service name, which is also its hostname.
  """
  name: String!

  """
  TCP ports the service publishes.
  """
  ports: [ComposePort!]!

  """
  The running service.
  """
  service: Service!
}

"""
A service's configuration as resolved by 'docker compose config'.
"""
type ComposeServiceSpec {
  """
  Service name.
  """
  name: String!

  """
  Image the service runs. Empty when the service declares a build instead.
  """
  image: String! = ""

  """
  Entrypoint the service overrides its image's with. Empty to keep the
  image's.
  """
  entrypoint: [String!]! = []

  """
  Command the service overrides its image's with. Empty to keep the image's.
  """
  command: [String!]! = []

  """
  Build context as resolved by 'docker compose config', under /ws. Empty
  when the service runs an image.
  """
  buildContext: String! = ""

  """
  Dockerfile of the service's build, relative to its context.
  """
  buildDockerfile: String! = ""

  """
  Target stage of the service's build. Empty for the final stage.
  """
  buildTarget: String! = ""

  """
  Args of the service's build configuration.
  """
  buildArgs: [ComposeBuildArg!]! = []

  """
  Environment variables declared by the service.
  """
  environment: [ComposeEnvVariable!]! = []

  """
  TCP ports the service publishes.
  """
  ports: [ComposePort!]! = []

  """
  Ports the service exposes without publishing them.
  """
  expose: [Int!]! = []

  """
  Services this service depends on.
  """
  dependsOn: [String!]! = []

  """
  User the service runs as. Empty for the image's.
  """
  user: String! = ""

  """
  Working directory of the service. Empty for the image's.
  """
  workingDir: String! = ""

  """
  Whether the service runs privileged.
  """
  privileged: Boolean! = false

  """
  Bind mounts inside the workspace, named volumes and tmpfs mounts.
  """
  mounts: [ComposeMount!]! = []

  """
  Secrets and configs read from files in the workspace.
  """
  files: [ComposeFileMount!]! = []

  """
  What up and injectServices can't reproduce for this service.
  """
  warnings: [String!]! = []
}

"""
A TCP port a Compose service publishes.
"""
type ComposePort {
  """
  Container port.
  """
  target: Int!

  """
  Published port, 0 when Compose would pick one.
  """
  published: Int! = 0
}

"""
A mount of a Compose service.
"""
type ComposeMount {
  """
  "bind", "volume" or "tmpfs".
  """
  kind: String!

  """
  Workspace-root-relative path of a bind mount, or the name of a volume.
  """
  source: String! = ""

  """
  Mount path in the container.
  """
  target: String!
}

"""
A secret or config file of a Compose service.
"""
type ComposeFileMount {
  """
  Workspace-root-relative path of the file.
  """
  source: String!

  """
  Path the file is mounted at in the container.
  """
  target: String!
}

"""
An environment variable declared by a Compose service.
"""
type ComposeEnvVariable {
  """
  Variable name.
  """
  name: String!

  """
  Variable value.
  """
  value: String! = ""
}

"""
A build arg of a Compose service's build configuration.
"""
type ComposeBuildArg {
  """
  Arg name.
  """
  name: String!

  """
  Arg value.
  """
  value: String! = ""
}
